# CIRISProxy LiteLLM Configuration - Auto-generated by Ansible
# Model routing for credit-gated LLM access
# Source: synced from CIRISProxy/litellm_config.yaml
#
# This file mirrors CIRISProxy/litellm_config.yaml. When the two drift,
# the monitored set in hooks/status_handler.py stops matching the serving
# set. Any change to the default chain must be mirrored in PROVIDERS there.

model_list:
  # Qwen 3.6-35B-A3B - PRIMARY model for CIRIS Agent (2026-04-27)
  # MoE: 35B total / 3B active params, 262K context
  # DeepInfra primary, OpenRouter backup, Groq 27B cross-model failover
  # extra_body.chat_template_kwargs.enable_thinking=false: disables Qwen3 reasoning chains by default
  - model_name: "qwen-3.6-35b"
    litellm_params:
      model: "deepinfra/Qwen/Qwen3.6-35B-A3B"
      api_key: "os.environ/DEEPINFRA_API_KEY"
      extra_body:
        chat_template_kwargs:
          enable_thinking: false

  - model_name: "deepinfra/qwen-3.6-35b"
    litellm_params:
      model: "deepinfra/Qwen/Qwen3.6-35B-A3B"
      api_key: "os.environ/DEEPINFRA_API_KEY"
      extra_body:
        chat_template_kwargs:
          enable_thinking: false

  - model_name: "openrouter/qwen-3.6-35b"
    litellm_params:
      model: "openrouter/qwen/qwen3.6-35b-a3b"
      api_key: "os.environ/OPENROUTER_API_KEY"
      extra_body:
        chat_template_kwargs:
          enable_thinking: false

  # Groq Qwen 3.6-27B - high-speed cross-model failover (2026-08-13)
  # Replaces Llama 4 Scout, which Groq retired. Same Qwen 3.6 family as the
  # primary, so tool-calling and prompt behaviour survive the failover.
  - model_name: "groq/qwen-3.6-27b"
    litellm_params:
      model: "groq/qwen/qwen3.6-27b"
      api_key: "os.environ/GROQ_API_KEY"
      extra_body:
        chat_template_kwargs:
          enable_thinking: false

  # Qwen 3.5-35B-A3B - kept for backwards compatibility
  - model_name: "qwen-3.5-35b"
    litellm_params:
      model: "openrouter/qwen/qwen3.5-35b-a3b"
      api_key: "os.environ/OPENROUTER_API_KEY"
      extra_body:
        chat_template_kwargs:
          enable_thinking: false

  - model_name: "openrouter/qwen-3.5-35b"
    litellm_params:
      model: "openrouter/qwen/qwen3.5-35b-a3b"
      api_key: "os.environ/OPENROUTER_API_KEY"
      extra_body:
        chat_template_kwargs:
          enable_thinking: false

  - model_name: "deepinfra/qwen-3.5-35b"
    litellm_params:
      model: "deepinfra/Qwen/Qwen3.5-35B-A3B"
      api_key: "os.environ/DEEPINFRA_API_KEY"
      extra_body:
        chat_template_kwargs:
          enable_thinking: false

  # Llama 4 - DEPRECATED, legacy aliases only (2026-08-13)
  #
  # Groq and Together AI retired these models. OpenRouter still serves them
  # for clients that have not migrated. Do not route new traffic here.
  - model_name: "llama-4-scout"
    litellm_params:
      model: "openrouter/meta-llama/llama-4-scout"
      api_key: "os.environ/OPENROUTER_API_KEY"

  - model_name: "openrouter/llama-4-scout"
    litellm_params:
      model: "openrouter/meta-llama/llama-4-scout"
      api_key: "os.environ/OPENROUTER_API_KEY"

  - model_name: "llama-4-maverick"
    litellm_params:
      model: "openrouter/meta-llama/llama-4-maverick"
      api_key: "os.environ/OPENROUTER_API_KEY"

  - model_name: "openrouter/llama-4-maverick"
    litellm_params:
      model: "openrouter/meta-llama/llama-4-maverick"
      api_key: "os.environ/OPENROUTER_API_KEY"

  # GPT-OSS-20B - OpenAI's open-weight model (Apache 2.0)
  # NOTE: Weak at structured outputs / tool calling - kept for reference
  - model_name: "gpt-oss-20b"
    litellm_params:
      model: "together_ai/openai/gpt-oss-20b"
      api_key: "os.environ/TOGETHER_API_KEY"
      max_tokens: 131072

  - model_name: "together/gpt-oss-20b"
    litellm_params:
      model: "together_ai/openai/gpt-oss-20b"
      api_key: "os.environ/TOGETHER_API_KEY"
      max_tokens: 131072

  - model_name: "groq/gpt-oss-20b"
    litellm_params:
      model: "groq/openai/gpt-oss-20b"
      api_key: "os.environ/GROQ_API_KEY"
      max_tokens: 131072

  - model_name: "openrouter/gpt-oss-20b"
    litellm_params:
      model: "openrouter/openai/gpt-oss-20b"
      api_key: "os.environ/OPENROUTER_API_KEY"
      max_tokens: 131072

  # Groq Models (fast, cost-effective)
  - model_name: "groq/llama-3.3-70b"
    litellm_params:
      model: "groq/llama-3.3-70b-versatile"
      api_key: "os.environ/GROQ_API_KEY"

  - model_name: "groq/llama-3.1-8b"
    litellm_params:
      model: "groq/llama-3.1-8b-instant"
      api_key: "os.environ/GROQ_API_KEY"

  # Together AI Models
  - model_name: "together/llama-3.1-70b"
    litellm_params:
      model: "together_ai/meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo"
      api_key: "os.environ/TOGETHER_API_KEY"

  - model_name: "together/llama-3.1-8b"
    litellm_params:
      model: "together_ai/meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo"
      api_key: "os.environ/TOGETHER_API_KEY"

  - model_name: "together/qwen-2.5-72b"
    litellm_params:
      model: "together_ai/Qwen/Qwen2.5-72B-Instruct-Turbo"
      api_key: "os.environ/TOGETHER_API_KEY"

  # OpenAI (optional fallback)
  - model_name: "openai/gpt-4o-mini"
    litellm_params:
      model: "gpt-4o-mini"
      api_key: "os.environ/OPENAI_API_KEY"

  - model_name: "openai/gpt-4o"
    litellm_params:
      model: "gpt-4o"
      api_key: "os.environ/OPENAI_API_KEY"

  # Aliases for simpler client usage
  # Default model for CIRIS Agent - Qwen 3.6-35B-A3B via DeepInfra (2026-04-27)
  - model_name: "default"
    litellm_params:
      model: "deepinfra/Qwen/Qwen3.6-35B-A3B"
      api_key: "os.environ/DEEPINFRA_API_KEY"
      extra_body:
        chat_template_kwargs:
          enable_thinking: false

  # Fast alias - Groq Qwen 3.6-27B (high-speed cross-model failover)
  - model_name: "fast"
    litellm_params:
      model: "groq/qwen/qwen3.6-27b"
      api_key: "os.environ/GROQ_API_KEY"
      extra_body:
        chat_template_kwargs:
          enable_thinking: false

litellm_settings:
  # Custom callback for CIRISBilling integration
  callbacks:
    - billing_callback.billing_callback_instance
  success_callback:
    - billing_callback.billing_callback_instance
  failure_callback:
    - billing_callback.billing_callback_instance

  # Drop unsupported parameters instead of erroring
  drop_params: true

  # Request timeout (seconds)
  request_timeout: 120

  # Set verbose for debugging (disable in production)
  set_verbose: false

  # Disable telemetry
  telemetry: false

router_settings:
  # Routing strategy for model groups with multiple deployments
  routing_strategy: "simple-shuffle"

  # Retry settings
  num_retries: 2
  retry_after: 1

  # Error-specific retry policies
  retry_policy:
    TimeoutErrorRetries: 1
    RateLimitErrorRetries: 2
    InternalServerErrorRetries: 1

  # Cooldown triggers - provider excluded after N failures per minute
  allowed_fails_policy:
    TimeoutErrorAllowedFails: 3
    RateLimitErrorAllowedFails: 5
    InternalServerErrorAllowedFails: 3

  # Seconds to exclude a failing provider from routing
  cooldown_time: 60

  # Fallback chain
  # Primary: Qwen 3.6 - DeepInfra 35B-A3B → OpenRouter 35B-A3B → Groq 27B
  fallbacks:
    - "default": ["openrouter/qwen-3.6-35b", "groq/qwen-3.6-27b"]
    - "qwen-3.6-35b": ["openrouter/qwen-3.6-35b", "groq/qwen-3.6-27b"]
    - "deepinfra/qwen-3.6-35b": ["openrouter/qwen-3.6-35b", "groq/qwen-3.6-27b"]
    - "openrouter/qwen-3.6-35b": ["deepinfra/qwen-3.6-35b", "groq/qwen-3.6-27b"]
    - "groq/qwen-3.6-27b": ["deepinfra/qwen-3.6-35b", "openrouter/qwen-3.6-35b"]
    # Fast alias - Groq first, then full-size Qwen 3.6 deployments
    - "fast": ["openrouter/qwen-3.6-35b", "deepinfra/qwen-3.6-35b"]
    # Legacy Llama 4 aliases (deprecated) - cross-model failover to Qwen 3.6
    - "llama-4-scout": ["openrouter/qwen-3.6-35b"]
    - "openrouter/llama-4-scout": ["openrouter/qwen-3.6-35b"]
    - "llama-4-maverick": ["openrouter/qwen-3.6-35b"]
    - "openrouter/llama-4-maverick": ["openrouter/qwen-3.6-35b"]
    - "groq/llama-3.3-70b": ["together/llama-3.1-70b", "openai/gpt-4o-mini"]

general_settings:
  # Master key for admin operations (not for client auth)
  master_key: "os.environ/LITELLM_MASTER_KEY"

  # Custom auth function - bypasses database and lets our callback handle auth
  custom_auth: "custom_auth.user_api_key_auth"

  # Disable the built-in database (we use CIRISBilling)
  database_url: null

  # Disable spend logs for ZDR compliance
  disable_spend_logs: true

  # Allow all origins for mobile clients
  allowed_ips: null
