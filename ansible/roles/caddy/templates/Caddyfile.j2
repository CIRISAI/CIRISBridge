# CIRISLens - Observability (US node only)
lens.{{ dns_soa }} {
    # ── CIRISServer (Node A, v0.5.0) — zero-env CLI-flag boot ─────────────
    # See ../../CIRISServer/FSD/BRIDGE_UPGRADE_v0.5.0.md. Hostname kept; endpoint
    # surface = frozen 7 read endpoints + /v1/identity + HTTP trace ingest.
    handle /lens/api/v1/* {
        header Access-Control-Allow-Origin "https://ciris.ai"
        reverse_proxy ciris-server:4243
    }

    handle /v1/identity {
        reverse_proxy ciris-server:4243
    }

    # /v1/federation/* — node-code (public bootstrap handle), self-key-record (the
    # canonical fingerprinted key_id), etc. /v1/identity emits the keystore alias;
    # /v1/federation/self-key-record emits the derived "<label>-<fp>" — that's the
    # one to use for the canonical-key_id verification gate until CIRISServer#34 lands.
    handle /v1/federation/* {
        reverse_proxy ciris-server:4243
    }

    # Trace-ingest 404 fix (runbook §5). The legacy CIRIS-AccordMetrics emitter
    # POSTs here; v0.5.0 accepts the path directly (no rewrite). Expected: 401
    # until the agent ships the 2.9.7 fold (persist v9 hybrid hard-cut; runbook §6).
    handle /lens-api/api/v1/accord/events {
        reverse_proxy ciris-server:4243
    }

    # ── ciris-status (Node B, v0.3.0) — ciris-server + StatusAdapter ──────
    # Read API binds inside the container on :4243 (same internal port as Node A;
    # different container, different docker DNS name → no clash on lens_cirislens).
    # flush_interval -1 = SSE (/api/v1/*/live) + WS (/api/v1/status/ws) pass-through.
    # Node B's memory diagnostics (/api/v1/debug/memory) is UNGATED in the image:
    # no auth, and it answers on the published port, unlike ciris-server 0.5.199
    # which serves the equivalent report loopback-only behind CIRIS_DIAGNOSTICS
    # (403 from the docker bridge gateway). It discloses no keys/identity/PII —
    # only mallinfo2 + /proc counters — but unauthenticated it is a live feedback
    # oracle: an attacker can watch RssAnon/VmSwap/fordblks move in response to
    # their own traffic and steer a memory-exhaustion attempt on a node that
    # already carries a known allocator-churn problem (CIRISStatus#69).
    #
    # PARTIAL mitigation. This closes the discoverable hostname path only;
    # http://<host>:4253/api/v1/debug/* still answers directly, because 4253 must
    # stay open for remote agents' delegation claims. The real fix is gating the
    # route in the image the way 0.5.199 does — filed upstream.
    # More specific matcher than /status/*, so Caddy prefers it.
    handle /status/api/v1/debug/* {
        respond "404 — diagnostics not exposed" 404
    }

    handle_path /status/* {
        reverse_proxy ciris-status:4243 {
            flush_interval -1
        }
    }

    # Legacy-compat: ciris.ai/ciris-scoring/ JS bundle hits the bare /api/v1/scoring
    # path. Route to Node B's adapter surface — field-compatible per CIRISStatus README.
    handle /api/v1/scoring {
        reverse_proxy ciris-status:4243
    }
    handle /api/v1/scoring/* {
        reverse_proxy ciris-status:4243
    }

    # OLD lens endpoints (/api/v1/accord/*, /api/v1/covenant/*, /api/v1/scoring/*,
    # /api/v1/identity, /lens-api/*, /ingest/*, Grafana fallback) are GONE.
    # Clients on those paths will 404. Migration guide in the runbook above.
    handle {
        respond "404 — lens retired; see /v1/identity and /lens/api/v1/*" 404
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        -Server
    }

    log {
        output file /var/log/caddy/lens.log
        format json
    }
}
{% endif %}

{% if caddy_failover_billing_domains is defined %}
# Failover: billing endpoints from the failed region.
# Set caddy_failover_billing_domains in inventory during an outage; clear on failback.
{% for domain in caddy_failover_billing_domains %}
{{ domain }} {
    reverse_proxy host.docker.internal:8000 {
        health_uri /health
        health_interval 30s
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        -Server
    }

    log {
        output file /var/log/caddy/billing-failover.log
        format json
    }
}
{% endfor %}
{% endif %}

