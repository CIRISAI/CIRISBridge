# Caddy Configuration - Auto-generated by Ansible
# TLS termination for CIRISBridge services

{
    email {{ caddy_email }}
    acme_ca https://acme-v02.api.letsencrypt.org/directory

    # Trust Cloudflare proxy IPs for real client IP forwarding
    # Source: https://www.cloudflare.com/ips/
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    }
}

# Billing API
billing1.{{ dns_soa }} {
    reverse_proxy host.docker.internal:8000 {
        health_uri /health
        health_interval 30s
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        -Server
    }

    log {
        output file /var/log/caddy/billing.log
        format json
    }
}

# LLM Proxy (primary endpoint — llm01.* is the name agents use; proxy1.* is the canonical infra name)
# EU omits llm01.{{ dns_soa }} — no DNS record for llm01.ciris-services-2.ai; EU legacy name is llm01.ciris-services-eu-1.com
proxy1.{{ dns_soa }}{% if inventory_hostname == 'vultr' %}, llm01.{{ dns_soa }}{% endif %} {
{% if proxy_enabled | default(true) %}
    reverse_proxy ciris-proxy:4000 {
        health_uri /health/liveliness
        health_interval 30s
    }
{% else %}
    respond "Service temporarily unavailable" 503
{% endif %}

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        -Server
    }

    log {
        output file /var/log/caddy/proxy1.log
        format json
    }
}

