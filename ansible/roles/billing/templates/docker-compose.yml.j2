# CIRISBilling - Auto-generated by Ansible

services:
  billing:
    image: {{ billing_image }}
    container_name: ciris-billing
    restart: unless-stopped
    # Unbounded json-file logs are a disk-fill path, and on this node a full
    # disk fail-safe demotes ciris-server out of its federation role
    # (lens_store=false). Cap every container: 3 x 50 MB max.
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "3"
    mem_limit: 512m
    env_file:
      - .env
    volumes:
      - /var/log/ciris/billing:/app/logs
{% if ciris_environment | default('production') == 'test' %}
    ports:
      - "127.0.0.1:{{ billing_port }}:8000"
    networks:
      - billing
{% else %}
    # Production: Use host networking for direct access to Spock postgres (127.0.0.1:5433)
    network_mode: host
{% endif %}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

{% if ciris_environment | default('production') == 'test' %}
networks:
  billing:
    driver: bridge
{% endif %}
