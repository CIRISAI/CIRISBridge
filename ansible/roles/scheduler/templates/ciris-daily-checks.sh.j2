#!/bin/bash
# CIRISBridge Daily Health Checks
# Runs cert-status and backup-verify checks; results go to the journal (ciris-scheduler)
# Managed by Ansible - do not edit manually

set -euo pipefail

NODE_NAME="{{ node_name }}"
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

log_event() {
  local level="$1"
  local message="$2"
  local event="$3"
  local metadata="$4"
  local priority

  case "${level}" in
    ERROR) priority=err ;;
    WARNING) priority=warning ;;
    *) priority=info ;;
  esac
  logger -t ciris-scheduler -p "user.${priority}" "node=${NODE_NAME} event=${event} ${message} ${metadata}" || true
}

echo "=== CIRISBridge Daily Checks - ${NODE_NAME} - $(date -u) ==="

# ============================================================================
# CERTIFICATE STATUS CHECK
# ============================================================================
echo ""
echo "--- Certificate Status Check ---"

{% if node_name == 'us' %}
DOMAINS="billing1.{{ primary_domain }} proxy1.{{ primary_domain }} agents.{{ primary_domain }} lens.{{ primary_domain }}"
{% else %}
# The sites the EU Caddy serves (see roles/caddy/templates/Caddyfile.j2).
DOMAINS="billing1.{{ dns_soa }} proxy1.{{ dns_soa }} {{ dns_soa }} llm01.ciris-services-eu-1.com"
{% endif %}

CERT_ISSUES=0
CERT_DETAILS=""

for domain in $DOMAINS; do
  CERT_INFO=$(echo | timeout 5 openssl s_client -servername "$domain" -connect "$domain:443" 2>/dev/null | openssl x509 -noout -dates 2>/dev/null || echo "ERROR")

  if echo "$CERT_INFO" | grep -q "ERROR"; then
    echo "FAILED: $domain - Cannot retrieve certificate"
    CERT_ISSUES=$((CERT_ISSUES + 1))
    CERT_DETAILS="${CERT_DETAILS}${domain}:FAILED,"
    continue
  fi

  NOT_AFTER=$(echo "$CERT_INFO" | grep "notAfter" | cut -d= -f2)
  EXPIRY_EPOCH=$(date -d "$NOT_AFTER" +%s 2>/dev/null || echo 0)
  CURRENT_EPOCH=$(date +%s)
  DAYS_REMAINING=$(( ($EXPIRY_EPOCH - $CURRENT_EPOCH) / 86400 ))

  if [ "$DAYS_REMAINING" -lt 7 ]; then
    echo "CRITICAL: $domain - Expires in $DAYS_REMAINING days"
    CERT_ISSUES=$((CERT_ISSUES + 1))
    CERT_DETAILS="${CERT_DETAILS}${domain}:${DAYS_REMAINING}d:CRITICAL,"
  elif [ "$DAYS_REMAINING" -lt 30 ]; then
    echo "WARNING: $domain - Expires in $DAYS_REMAINING days"
    CERT_DETAILS="${CERT_DETAILS}${domain}:${DAYS_REMAINING}d:WARNING,"
  else
    echo "OK: $domain - $DAYS_REMAINING days remaining"
    CERT_DETAILS="${CERT_DETAILS}${domain}:${DAYS_REMAINING}d:OK,"
  fi
done

if [ "$CERT_ISSUES" -gt 0 ]; then
  log_event "ERROR" "Certificate issues detected: ${CERT_ISSUES} problem(s)" "cert_check_failed" "{\"issues\": ${CERT_ISSUES}, \"details\": \"${CERT_DETAILS}\"}"
else
  log_event "INFO" "All certificates healthy" "cert_check_passed" "{\"details\": \"${CERT_DETAILS}\"}"
fi

# ============================================================================
# SPOCK BACKUP/REPLICATION STATUS CHECK
# ============================================================================
# Billing data lives on ciris-billing-spock (port 5433, multi-master via pgEdge
# Spock).
echo ""
echo "--- Spock Replication Check ---"

REPLICATION_OK=true
REPLICATION_DETAILS=""
LAG_MB=0
PSQL_DOCKER="docker exec -e PGPASSWORD={{ billing_db_password }} ciris-billing-spock /opt/pgedge/pg15/bin/psql -p 5433 -U billing -d ciris_billing -t"

if docker ps --format '{% raw %}{{.Names}}{% endraw %}' | grep -q '^ciris-billing-spock$'; then
  # Subscription status — Spock catalog
  SUB_STATUS=$($PSQL_DOCKER -A -c "SELECT status FROM spock.sub_show_status();" 2>/dev/null || echo "ERROR")

  if [ "$SUB_STATUS" = "ERROR" ] || [ -z "$SUB_STATUS" ]; then
    echo "WARNING: Cannot query spock.sub_show_status"
    REPLICATION_DETAILS="query_failed"
  elif ! echo "$SUB_STATUS" | grep -q "replicating"; then
    echo "CRITICAL: Spock subscription not in 'replicating' state: $SUB_STATUS"
    REPLICATION_OK=false
    REPLICATION_DETAILS="sub_state_${SUB_STATUS}"
  else
    echo "OK: Spock subscription replicating"
    REPLICATION_DETAILS="active"
  fi

  # Active Spock slot retention — bytes / MB
  LAG_BYTES=$($PSQL_DOCKER -A -c "
    SELECT COALESCE(MAX(pg_wal_lsn_diff(pg_current_wal_lsn(), restart_lsn))::bigint, 0)
    FROM pg_replication_slots WHERE slot_name LIKE 'spk_%' AND active = true;
  " 2>/dev/null | tr -d '[:space:]' || echo "0")
  LAG_MB=$((${LAG_BYTES:-0} / 1048576))

  if [ "$LAG_MB" -gt 100 ]; then
    echo "WARNING: Spock slot retention ${LAG_MB}MB"
    REPLICATION_DETAILS="${REPLICATION_DETAILS},retained_${LAG_MB}MB"
  else
    echo "OK: Spock slot retention ${LAG_MB}MB"
  fi

  # Orphan-slot canary — non-Spock slots that shouldn't exist post-cutover
  ORPHANS=$($PSQL_DOCKER -A -c "SELECT COUNT(*) FROM pg_replication_slots WHERE slot_name NOT LIKE 'spk_%';" 2>/dev/null | tr -d '[:space:]' || echo "0")
  if [ "${ORPHANS:-0}" -gt 0 ]; then
    echo "WARNING: ${ORPHANS} non-Spock slot(s) found (post-cutover should be 0)"
    REPLICATION_DETAILS="${REPLICATION_DETAILS},orphan_slots_${ORPHANS}"
  fi
else
  echo "ERROR: ciris-billing-spock container not running"
  REPLICATION_OK=false
  REPLICATION_DETAILS="spock_down"
fi

if [ "$REPLICATION_OK" = false ]; then
  log_event "ERROR" "Spock replication issue" "replication_check_failed" "{\"details\": \"${REPLICATION_DETAILS}\"}"
else
  log_event "INFO" "Spock replication healthy" "replication_check_passed" "{\"details\": \"${REPLICATION_DETAILS}\", \"lag_mb\": ${LAG_MB}}"
fi

# ============================================================================
# CONNTRACK TABLE CHECK
# nf_conntrack exhaustion caused the 2026-08-20 US node network freeze.
# Alert at >80% of max (now 524288) to allow time to react.
# ============================================================================
echo ""
echo "--- Conntrack Table Check ---"

CT_COUNT=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo "0")
CT_MAX=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null || echo "524288")
CT_PCT=0
if [ "$CT_MAX" -gt 0 ]; then
  CT_PCT=$(( CT_COUNT * 100 / CT_MAX ))
fi

if [ "$CT_PCT" -lt 80 ]; then
  echo "OK: conntrack ${CT_COUNT}/${CT_MAX} (${CT_PCT}%)"
  log_event "INFO" "Conntrack table healthy" "conntrack_check_passed" "{\"count\": ${CT_COUNT}, \"max\": ${CT_MAX}, \"pct\": ${CT_PCT}}"
elif [ "$CT_PCT" -lt 95 ]; then
  echo "WARNING: conntrack ${CT_COUNT}/${CT_MAX} (${CT_PCT}%) — approaching limit"
  log_event "WARNING" "Conntrack table filling" "conntrack_check_warning" "{\"count\": ${CT_COUNT}, \"max\": ${CT_MAX}, \"pct\": ${CT_PCT}}"
else
  echo "CRITICAL: conntrack ${CT_COUNT}/${CT_MAX} (${CT_PCT}%) — near exhaustion, network freeze risk"
  log_event "ERROR" "Conntrack table near exhaustion" "conntrack_check_critical" "{\"count\": ${CT_COUNT}, \"max\": ${CT_MAX}, \"pct\": ${CT_PCT}}"
fi

# ============================================================================
# DOCKER HEALTH CHECK
# ============================================================================
echo ""
echo "--- Docker Container Health ---"

UNHEALTHY_CONTAINERS=$(docker ps --filter "health=unhealthy" --format '{% raw %}{{.Names}}{% endraw %}' 2>/dev/null || echo "")
STOPPED_CIRIS=$(docker ps -a --filter "status=exited" --format '{% raw %}{{.Names}}{% endraw %}' 2>/dev/null | grep -E '^ciris-' || echo "")

if [ -n "$UNHEALTHY_CONTAINERS" ]; then
  echo "WARNING: Unhealthy containers: $UNHEALTHY_CONTAINERS"
  log_event "WARNING" "Unhealthy containers detected" "container_health_warning" "{\"unhealthy\": \"${UNHEALTHY_CONTAINERS}\"}"
elif [ -n "$STOPPED_CIRIS" ]; then
  echo "WARNING: Stopped CIRIS containers: $STOPPED_CIRIS"
  log_event "WARNING" "Stopped CIRIS containers" "container_stopped_warning" "{\"stopped\": \"${STOPPED_CIRIS}\"}"
else
  echo "OK: All containers healthy"
  log_event "INFO" "All containers healthy" "container_health_passed" "{}"
fi

# ============================================================================
# DISK SPACE CHECK
# ============================================================================
echo ""
echo "--- Disk Space Check ---"

DISK_USAGE=$(df -h / | awk 'NR==2 {print $5}' | tr -d '%')
DOCKER_USAGE=$(df -h /var/lib/docker 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%' || echo "$DISK_USAGE")

if [ "$DISK_USAGE" -gt 90 ] || [ "$DOCKER_USAGE" -gt 90 ]; then
  echo "CRITICAL: Disk usage critical - Root: ${DISK_USAGE}%, Docker: ${DOCKER_USAGE}%"
  log_event "ERROR" "Disk space critical" "disk_check_critical" "{\"root_percent\": ${DISK_USAGE}, \"docker_percent\": ${DOCKER_USAGE}}"
elif [ "$DISK_USAGE" -gt 80 ] || [ "$DOCKER_USAGE" -gt 80 ]; then
  echo "WARNING: Disk usage elevated - Root: ${DISK_USAGE}%, Docker: ${DOCKER_USAGE}%"
  log_event "WARNING" "Disk space warning" "disk_check_warning" "{\"root_percent\": ${DISK_USAGE}, \"docker_percent\": ${DOCKER_USAGE}}"
else
  echo "OK: Disk usage normal - Root: ${DISK_USAGE}%, Docker: ${DOCKER_USAGE}%"
  log_event "INFO" "Disk space healthy" "disk_check_passed" "{\"root_percent\": ${DISK_USAGE}, \"docker_percent\": ${DOCKER_USAGE}}"
fi

echo ""
echo "=== Daily checks complete ==="

# Final summary
log_event "INFO" "Daily checks completed" "daily_checks_complete" "{\"cert_issues\": ${CERT_ISSUES}, \"replication_ok\": ${REPLICATION_OK}, \"disk_percent\": ${DISK_USAGE}}"
